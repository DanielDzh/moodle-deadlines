{
  // Telegram reminders Worker. Separate from the site Worker (../wrangler.jsonc).
  "name": "moodle-deadlines-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    // Origins allowed to call /api/* from a browser (the site). Local development adds localhost via .dev.vars.
    "ALLOWED_ORIGINS": "https://moodle-dedlainy.tinyapp.workers.dev",
    "BOT_USERNAME": "moodle_deadlines_bot"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moodle-deadlines-bot",
      "database_id": "4ef67dd9-4a57-4091-a451-5b6bbf6df77d",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // Every minute: send reminders and refresh data from Moodle.
    "crons": ["* * * * *"]
  }
}
